# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/repurpose/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/repurpose-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/repurpose-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# REPURPOSE_LISTEN=127.0.0.1:63450
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# REPURPOSE_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/repurpose.service) less the pool and some headroom.
# REPURPOSE_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# REPURPOSE_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# REPURPOSE_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# REPURPOSE_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# REPURPOSE_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# REPURPOSE_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/repurpose-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# REPURPOSE_REQUEST_TIMEOUT_MS=5000
# REPURPOSE_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# REPURPOSE_MAX_IN_FLIGHT=64

# --- Database (crates/repurpose-db) ------------------------------------------------------
# REPURPOSE_DB_MAX_CONNECTIONS=16
# REPURPOSE_DB_ACQUIRE_TIMEOUT_MS=2000
# REPURPOSE_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# REPURPOSE_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# REPURPOSE_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least REPURPOSE_ERROR_MIN_REQUESTS were answered.
# REPURPOSE_ERROR_RATE_PERMILLE=50
# REPURPOSE_ERROR_MIN_REQUESTS=20
# REPURPOSE_LOG=info
# json for journald; text for a terminal.
# REPURPOSE_LOG_FORMAT=json

# --- Accounts (crates/repurpose-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# REPURPOSE_SMTP_RELAY=
# REPURPOSE_MAIL_FROM=noreply@content-repurposing.invalid
# Where links in emails point.
# REPURPOSE_PUBLIC_URL=http://127.0.0.1:63450
# REPURPOSE_COOKIE_SECURE=true
# REPURPOSE_SESSION_TTL_S=604800
# REPURPOSE_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# REPURPOSE_TRUSTED_PROXIES=
# REPURPOSE_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# REPURPOSE_PLAN_MAX_MEMBERS=10
# REPURPOSE_PLAN_MAX_TOKENS=10
# REPURPOSE_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/repurpose/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role repurpose_app
#   migration-database-url  repurposectl migrate, digests, fingerprint, prune-events (repurpose_owner)
#   admin-database-url      repurposectl bootstrap only
#   owner-password          repurposectl bootstrap only
#   app-password            repurposectl bootstrap only
# REPURPOSE_DATABASE_URL_FILE=/etc/repurpose/credentials/database-url
# REPURPOSE_MIGRATION_DATABASE_URL_FILE=/etc/repurpose/credentials/migration-database-url
# REPURPOSE_ADMIN_DATABASE_URL_FILE=/etc/repurpose/credentials/admin-database-url
# REPURPOSE_OWNER_PASSWORD_FILE=/etc/repurpose/credentials/owner-password
# REPURPOSE_APP_PASSWORD_FILE=/etc/repurpose/credentials/app-password
